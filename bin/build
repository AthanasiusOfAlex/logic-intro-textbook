#!/bin/sh

base_name=analytic-introduction
languages=("en" "it")

input_path=md
output_path=output

input_extension=md

epub_extension=epub
epub_settings=""

pdf_extension=pdf
pdf_settings="--pdf-engine=lualatex --template=templates/logic-textbook.latex"

latex_extension=tex
latex_settings="$pdf_settings --standalone"

for language in "${languages[@]}"; do
   # cat $input_path/*-$language.$input_extension | pandoc $latex_settings -o $output_path/$base_name-$language.$output.$latex_extension
   cat $input_path/*-$language.$input_extension | pandoc $epub_settings -o $output_path/$base_name-$language.$epub_extension
   cat $input_path/*-$language.$input_extension | pandoc $pdf_settings -o $output_path/$base_name-$language.$pdf_extension
done