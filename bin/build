#!/bin/sh

base_name=analytic-introduction
languages=("en" "it")

input_path=md
output_path=pdf

input_extension=md

epub_extension=epub
epub_settings="-o $output_path/$base_name-$language.$output.$epub_extension"

pdf_extension=epub
pdf_settings="-o $output_path/$base_name-$language.$output.$epub_extension --pdf-engine=xelatex --standalone --template templates/logic-textbook.latex --top-level-division=chapter"

for language in "${languages[@]}"; do
    cat $input_path/*-$language.$input_extension | pandoc $epub_settings
    cat $input_path/*-$language.$input_extension | pandoc $pdf_settings
done